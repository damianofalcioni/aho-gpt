<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="?attr/appOutlineColor" />
            <stroke android:width="2dp" android:color="?attr/appTextColor" />
        </shape>
    </item>
    <item>
        <ripple android:color="?attr/appRippleColor">
            <item>
                <shape>
                    <corners android:radius="18dp" />
                    <solid android:color="?attr/appSurfaceColor" />
                    <stroke android:width="1dp" android:color="?attr/appOutlineColor" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
