<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/app_outline" />
            <stroke android:width="2dp" android:color="@color/app_text" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/app_ripple">
            <item android:id="@android:id/mask">
                <shape android:shape="oval"><solid android:color="@color/app_text" /></shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/app_surface" />
                    <stroke android:width="1dp" android:color="@color/app_outline" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
