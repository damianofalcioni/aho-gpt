<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="@dimen/home_padding">
        <ImageButton
            android:id="@+id/about_settings"
            android:layout_width="@dimen/home_logo_size" android:layout_height="@dimen/home_logo_size"
            android:background="@drawable/bg_button" android:padding="8dp"
            android:src="@drawable/ic_assistant" android:scaleType="fitCenter"
            android:contentDescription="@string/about_settings"
            android:nextFocusDown="@id/speak" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button
            android:id="@+id/speak"
            android:layout_width="@dimen/home_speak_size" android:layout_height="@dimen/home_speak_size"
            android:layout_marginTop="@dimen/home_spacing" android:layout_marginBottom="@dimen/home_spacing"
            android:background="@drawable/bg_speak" android:padding="16dp"
            android:drawableTop="@drawable/ic_mic" android:drawablePadding="12dp"
            android:text="@string/speak" android:textSize="@dimen/home_speak_text"
            android:nextFocusUp="@id/about_settings" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</ScrollView>
