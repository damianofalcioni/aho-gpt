<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/page_padding">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="22sp" />
        <TextView android:id="@+id/app_version" style="@style/SettingsBody" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsBody" android:layout_marginTop="16dp"
            android:textColor="@color/app_text" android:textSize="16sp" android:text="@string/about_description" />
        <TextView android:id="@+id/about_homepage" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_home" android:text="@string/about_homepage" />
        <TextView android:id="@+id/about_source" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_star" android:text="@string/about_source" />
        <TextView android:id="@+id/about_issues" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_bug" android:text="@string/about_issues" />
        <TextView android:id="@+id/about_changelog" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_list" android:text="@string/about_changelog" />
        <TextView android:id="@+id/about_privacy" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_info" android:text="@string/about_privacy" />
        <TextView android:id="@+id/about_terms" style="@style/AboutLink"
            android:drawableStart="@drawable/ic_list" android:text="@string/about_terms" />
        <TextView style="@style/SettingsBody" android:layout_marginTop="16dp" android:text="@string/about_legal" />
        <TextView style="@style/SettingsBody" android:layout_marginTop="12dp" android:text="@string/about_credits" />
        <TextView style="@style/SettingsTitle" android:text="@string/settings_heading" />
        <TextView style="@style/SettingsHeading" android:text="@string/languages_heading" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/use_system_language" />
            <ImageButton android:id="@+id/app_language_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/configure_app_language" />
            <Switch android:id="@+id/use_system_language" style="@style/SettingsSwitch"
                android:contentDescription="@string/use_system_language" />
            <ImageButton android:id="@+id/app_language_info" style="@style/SettingsInfo"
                android:contentDescription="@string/app_language_title" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/tts_short" />
            <ImageButton android:id="@+id/tts_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/configure_tts" />
            <Switch android:id="@+id/tts_enabled" style="@style/SettingsSwitch" android:contentDescription="@string/enable_tts" />
            <ImageButton android:id="@+id/tts_info" style="@style/SettingsInfo" android:contentDescription="@string/tts_information" />
        </LinearLayout>
        <TextView android:id="@+id/tts_provider_status" style="@style/SettingsBody" android:textSize="13sp"
            android:accessibilityLiveRegion="polite" android:text="@string/language_support_loading" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/stt_short" />
            <ImageButton android:id="@+id/stt_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/configure_stt" />
            <Switch android:id="@+id/stt_enabled" style="@style/SettingsSwitch" android:contentDescription="@string/enable_stt" />
            <ImageButton android:id="@+id/stt_info" style="@style/SettingsInfo" android:contentDescription="@string/stt_information" />
        </LinearLayout>
        <TextView android:id="@+id/stt_provider_status" style="@style/SettingsBody" android:textSize="13sp"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <TextView style="@style/SettingsSectionHeading" android:text="@string/account_heading" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/chatgpt" />
            <ImageButton android:id="@+id/chatgpt_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/configure_chatgpt" />
            <Switch android:id="@+id/chatgpt_enabled" style="@style/SettingsSwitch" android:contentDescription="@string/enable_chatgpt" />
            <ImageButton android:id="@+id/chatgpt_info" style="@style/SettingsInfo" android:contentDescription="@string/configure_chatgpt" />
        </LinearLayout>
        <TextView style="@style/SettingsSectionHeading" android:text="@string/device_heading" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/tools" />
            <ImageButton android:id="@+id/tools_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/configure_tools" />
            <Switch android:id="@+id/tools_enabled" style="@style/SettingsSwitch" android:contentDescription="@string/enable_tools" />
            <ImageButton android:id="@+id/tools_info" style="@style/SettingsInfo" android:contentDescription="@string/tools_information" />
        </LinearLayout>
        <TextView style="@style/SettingsSectionHeading" android:text="@string/log_advanced" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/log_external_storage" />
            <Switch android:id="@+id/log_external_storage" style="@style/SettingsSwitch"
                android:contentDescription="@string/log_external_storage" />
            <ImageButton android:id="@+id/log_storage_info" style="@style/SettingsInfo"
                android:contentDescription="@string/setting_information" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="@string/logs" />
            <ImageButton android:id="@+id/log_settings" style="@style/SettingsIcon"
                android:src="@drawable/ic_settings" android:contentDescription="@string/log_configure" />
            <Switch android:id="@+id/log_enabled" style="@style/SettingsSwitch" android:contentDescription="@string/log_enable" />
            <ImageButton android:id="@+id/log_info" style="@style/SettingsInfo" android:contentDescription="@string/log_information" />
        </LinearLayout>
        <TextView style="@style/SettingsTitle" android:text="@string/diagnostic_heading" />
        <LinearLayout android:id="@+id/diagnostic_access" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
