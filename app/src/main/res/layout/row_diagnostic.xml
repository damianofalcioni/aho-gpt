<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_info" android:clickable="true" android:focusable="true"
    android:paddingTop="6dp" android:paddingBottom="6dp">
    <View android:id="@+id/diagnostic_mark" android:layout_width="12dp" android:layout_height="12dp"
        android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/diagnostic_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="15sp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/diagnostic_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="100dp" android:layout_marginStart="12dp" android:gravity="end"
        android:textSize="14sp" android:importantForAccessibility="no" />
</LinearLayout>
