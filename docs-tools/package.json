{
  "name": "aho-gpt-docs-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node minify-css.mjs",
    "check:css-build": "node minify-css.mjs --check",
    "lint:css": "stylelint \"../docs/styles.css\" --config stylelint.config.mjs",
    "check:links": "node check-links.mjs",
    "check": "npm run lint:css && npm run check:css-build && npm run check:links"
  },
  "devDependencies": {
    "@projectwallace/stylelint-plugin": "0.7.0",
    "css-tree": "3.2.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  }
}
